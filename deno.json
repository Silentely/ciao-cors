{
  "name": "ciao-cors",
  "version": "1.3.2",
  "exports": "./server.ts",
  "description": "A powerful CORS proxy server with advanced security features",
  "author": "Silentely",
  "license": "Anti-Capitalist Software License",
  "compilerOptions": {
    "lib": [
      "deno.window"
    ],
    "strict": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "dev": "deno run --allow-net --allow-env --allow-read --watch main.ts",
    "check": "deno check server.ts main.ts",
    "lint": "deno lint",
    "fmt": "deno fmt server.ts main.ts server_test.ts",
    "test": "deno test --allow-net --allow-env --allow-run=deno",
    "security-check": "bash security-check.sh"
  },
  "exclude": [
    "node_modules/",
    "*.backup",
    "*.log"
  ]
}
